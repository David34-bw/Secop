<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" styleClass="desplazable" xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.secopradar.controlador.AdminControlador">
    <VBox styleClass="pagina" spacing="14">
        <padding><Insets top="26" right="32" bottom="32" left="32"/></padding>
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label styleClass="titulo-pagina" text="Administración" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            <Button text="Recargar" styleClass="boton-borde" onAction="#recargar"/>
        </HBox>
        <Label fx:id="mensaje" styleClass="aviso-exito" wrapText="true" maxWidth="Infinity"/>

        <HBox spacing="14">
            <VBox styleClass="cifra" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                <Label fx:id="totalUsuarios" styleClass="cifra-numero" text="0"/>
                <Label styleClass="texto-chico" text="usuarios"/>
            </VBox>
            <VBox styleClass="cifra" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                <Label fx:id="totalPerfiles" styleClass="cifra-numero" text="0"/>
                <Label styleClass="texto-chico" text="perfiles"/>
            </VBox>
            <VBox styleClass="cifra" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                <Label fx:id="totalProcesos" styleClass="cifra-numero" text="0"/>
                <Label styleClass="texto-chico" text="procesos en la base"/>
            </VBox>
            <VBox styleClass="cifra" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                <Label fx:id="totalCoincidencias" styleClass="cifra-numero" text="0"/>
                <Label styleClass="texto-chico" text="coincidencias"/>
            </VBox>
        </HBox>

        <VBox styleClass="caja" spacing="8">
            <padding><Insets top="18" right="18" bottom="18" left="18"/></padding>
            <Label styleClass="subtitulo" text="Actualización de datos de SECOP II"/>
            <Label fx:id="ultimoIngreso" styleClass="texto-chico" wrapText="true"/>
            <Label fx:id="estadoActualizacion" wrapText="true"/>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label styleClass="texto-chico" text="Días hacia atrás"/>
                <Spinner fx:id="dias" prefWidth="90" editable="true"/>
                <Button fx:id="botonActualizar" text="Descargar de SECOP y cruzar ahora" styleClass="boton-azul" onAction="#actualizar"/>
            </HBox>
        </VBox>

        <VBox styleClass="caja" spacing="8">
            <padding><Insets top="18" right="18" bottom="18" left="18"/></padding>
            <Label styleClass="subtitulo" text="Últimas descargas"/>
            <TableView fx:id="tablaIngesta" prefHeight="190">
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                <placeholder><Label text="Todavía no hay registros." styleClass="texto-chico"/></placeholder>
            </TableView>
            <Label styleClass="subtitulo" text="Últimos cruces con los perfiles">
                <VBox.margin><Insets top="8"/></VBox.margin>
            </Label>
            <TableView fx:id="tablaCruce" prefHeight="190">
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                <placeholder><Label text="Todavía no hay registros." styleClass="texto-chico"/></placeholder>
            </TableView>
        </VBox>

        <VBox styleClass="caja" spacing="8">
            <padding><Insets top="18" right="18" bottom="18" left="18"/></padding>
            <Label styleClass="subtitulo" text="Usuarios"/>
            <Label styleClass="texto-chico" wrapText="true" text="Cambia el rol o el plan con las listas; los cambios se guardan al instante."/>
            <TableView fx:id="tablaUsuarios" prefHeight="260">
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                <placeholder><Label text="Todavía no hay registros." styleClass="texto-chico"/></placeholder>
                <columns>
                    <TableColumn fx:id="colCorreo" text="Correo" prefWidth="220"/>
                    <TableColumn fx:id="colRol" text="Rol" prefWidth="110"/>
                    <TableColumn fx:id="colPlanEfectivo" text="Plan efectivo" prefWidth="170"/>
                    <TableColumn fx:id="colCreada" text="Creada" prefWidth="150"/>
                    <TableColumn fx:id="colPlan" text="Asignar plan" prefWidth="130"/>
                    <TableColumn fx:id="colAcciones" text="" prefWidth="130"/>
                </columns>
            </TableView>
        </VBox>

        <VBox fx:id="cajaRanking" styleClass="caja" spacing="6">
            <padding><Insets top="18" right="18" bottom="18" left="18"/></padding>
            <Label styleClass="subtitulo" text="Profesiones más elegidas"/>
            <VBox fx:id="ranking" spacing="3"/>
        </VBox>
    </VBox>
</ScrollPane>
