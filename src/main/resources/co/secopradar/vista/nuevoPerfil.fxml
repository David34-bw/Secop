<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TreeView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.secopradar.controlador.NuevoPerfilControlador">
    <center>
        <ScrollPane fx:id="desplazable" fitToWidth="true" styleClass="desplazable">
            <VBox styleClass="pagina" spacing="10">
                <padding><Insets top="22" right="32" bottom="28" left="32"/></padding>
                <Hyperlink text="← Volver a Mis búsquedas" onAction="#volver"/>
                <Label styleClass="titulo-pagina" text="Nuevo perfil"/>
                <Label styleClass="texto-chico" text="Los campos con * son obligatorios."/>

                <!-- 1. Profesión -->
                <Label styleClass="paso-titulo" text="1  Profesión"/>
                <VBox fx:id="grupoProfesion" styleClass="grupo" spacing="6">
                    <Label styleClass="etiqueta" text="¿A qué te dedicas? *"/>
                    <ComboBox fx:id="profesion" promptText="Elige tu profesión..." prefWidth="420"/>
                    <TextField fx:id="profesionOtra" promptText="Escribe tu profesión u oficio, ej: Ingeniero mecánico" maxWidth="520"/>
                    <Label fx:id="errorProfesion" styleClass="error-campo" wrapText="true"/>
                </VBox>
                <Label fx:id="avisoDirecta" styleClass="aviso-alerta" wrapText="true" maxWidth="Infinity"/>

                <VBox fx:id="grupoNombre" styleClass="grupo" spacing="6">
                    <Label styleClass="etiqueta" text="Nombre del perfil *"/>
                    <TextField fx:id="nombre" promptText="Ej: Software para alcaldías" maxWidth="520"/>
                    <Label fx:id="errorNombre" styleClass="error-campo" wrapText="true"/>
                </VBox>

                <Label styleClass="etiqueta" text="Áreas (categorías UNSPSC)"/>
                <FlowPane fx:id="areasElegidas" hgap="8" vgap="8"/>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <TextField fx:id="buscarArea" promptText="Filtrar áreas: software, aseo, obra..." HBox.hgrow="ALWAYS"/>
                    <Button text="Agregar / quitar área" styleClass="boton-borde" onAction="#alternarAreaSeleccionada"/>
                </HBox>
                <TreeView fx:id="arbolAreas" prefHeight="220" showRoot="false"/>
                <Label styleClass="texto-chico" text="Doble clic en un área para agregarla o quitarla. Elegir una subárea reemplaza a su área general."/>

                <GridPane hgap="18" vgap="6">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50"/>
                        <ColumnConstraints percentWidth="50"/>
                    </columnConstraints>
                    <VBox spacing="6">
                        <Label styleClass="etiqueta" text="Palabras clave"/>
                        <TextField fx:id="entradaClave" promptText="Escribe y presiona Enter"/>
                        <Label styleClass="texto-chico" wrapText="true" text="Frases que deben aparecer en el nombre o la descripción del proceso."/>
                        <FlowPane fx:id="chipsClave" hgap="6" vgap="6"/>
                    </VBox>
                    <VBox spacing="6" GridPane.columnIndex="1">
                        <Label styleClass="etiqueta" text="Excluir"/>
                        <TextField fx:id="entradaExcluir" promptText="Escribe y presiona Enter"/>
                        <Label styleClass="texto-chico" wrapText="true" text="Si aparecen, el proceso se descarta. &quot;compras de bienes&quot; quita suministros y compras."/>
                        <FlowPane fx:id="chipsExcluir" hgap="6" vgap="6"/>
                    </VBox>
                </GridPane>

                <!-- 2. Dónde -->
                <Label styleClass="paso-titulo" text="2  Dónde"/>
                <VBox fx:id="contenedorDonde" spacing="10"/>
                <Label styleClass="etiqueta" text="Ciudades (opcional)"/>
                <TextField fx:id="entradaCiudad" promptText="Como las nombra SECOP, ej: Medellín. Enter para agregar" maxWidth="520"/>
                <FlowPane fx:id="chipsCiudad" hgap="6" vgap="6"/>

                <!-- 3. Ajustes -->
                <Label styleClass="paso-titulo" text="3  Ajustes"/>
                <VBox fx:id="contenedorAjustes" spacing="14"/>
                <Label styleClass="etiqueta" text="Días mínimos antes del cierre (opcional)"/>
                <TextField fx:id="dias" promptText="Ej: 3" maxWidth="120"/>
            </VBox>
        </ScrollPane>
    </center>
    <bottom>
        <HBox styleClass="barra-guardar" spacing="12" alignment="CENTER_LEFT">
            <padding><Insets top="12" right="32" bottom="12" left="32"/></padding>
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label fx:id="vistaPrevia" styleClass="texto-chico" wrapText="true"
                       text="Ajusta el perfil para ver cuántos procesos vigentes coinciden."/>
                <Label fx:id="errorGeneral" styleClass="aviso-error" wrapText="true" maxWidth="Infinity"/>
            </VBox>
            <Region/>
            <Button text="Cancelar" styleClass="boton-borde" onAction="#volver"/>
            <Button fx:id="guardar" text="Guardar perfil" styleClass="boton-ambar" onAction="#guardar"/>
        </HBox>
    </bottom>
</BorderPane>
