<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" styleClass="desplazable" xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.secopradar.controlador.PostulacionesControlador">
    <VBox styleClass="pagina" spacing="14">
        <padding><Insets top="26" right="32" bottom="32" left="32"/></padding>
        <Label styleClass="titulo-pagina" text="Mis postulaciones"/>
        <Label wrapText="true" maxWidth="760"
               text="Los procesos a los que decidiste presentarte. Cada uno avanza por las 7 etapas de SECOP II, en orden: registro, revisar el proceso, leer el pliego, reunir documentos, propuesta económica, presentar la oferta y evaluación."/>
        <VBox fx:id="vacio" styleClass="caja" spacing="8" alignment="CENTER">
            <padding><Insets top="30" right="18" bottom="30" left="18"/></padding>
            <Label styleClass="subtitulo" text="Todavía no te has postulado a ningún proceso"/>
            <Label styleClass="texto-chico" wrapText="true"
                   text="En Oportunidades o Buscar, usa el botón «Postularme» en el proceso que te interese."/>
            <Button text="Ver oportunidades" styleClass="boton-azul" onAction="#verOportunidades"/>
        </VBox>
        <VBox fx:id="lista" spacing="12"/>
    </VBox>
</ScrollPane>
